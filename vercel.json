{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mycrushpizza.com" }],
      "destination": "https://voltapizza.com/mycrushpizza",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mycrushpizza.com" }],
      "destination": "https://voltapizza.com/mycrushpizza",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
